    "bluebird": "^3.7.2",
    "collections": "git+https://github.com/Nexus-Mods/extension-collections.git#109ae729e82a9b27ade67969f771ba7f6542346b",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "^14.0.0",
    "i18next": "^19.0.1",
    "immutability-helper": "^3.0.1",
    "madge": "8.0.0",
    "modmeta-db": "git+https://github.com/Nexus-Mods/modmeta-db.git#daa8935b6e38e255ec192c908adfce35d47c0336",
