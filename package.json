{
  "name": "game-mount-and-blade-ii-bannerlord-butr",
  "version": "1.4.3",
  "description": "A Vortex extension for Mount and Blade II: Bannerlord mod management.",
  "author": "BUTR Team & Nexus Mods",
  "license": "GPL-3.0+",
  "main": "./dist/index.js",
  "config": {
    "extensionName": "Game: Mount and Blade II: Bannerlord (BUTR)",
    "issueTracker": "https://github.com/BUTR/game-mount-and-blade2/issues"
  },
  "scripts": {
    "clean": "node build.js clean",
    "build-extended": "node build.js build-extended",
    "build-update": "node build.js build-update",
    "build-webpack": "node build.js build-webpack",
    "build-7z": "node build.js build-7z",
    "build": "node build.js build",
    "build-dev": "node build.js build-dev",
    "lint": "eslint .",
    "lint:quiet": "eslint . --quiet",
    "lint:cycles": "node scripts/lint-cycles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier src \"packages/*/src/**\" --write",
    "format:check": "prettier src \"packages/*/src/**\" --check",
    "pre-commit": "lint-staged",
    "test": "vitest run"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@eslint-react/eslint-plugin": "2.3.7",
    "@eslint/js": "9.39.1",
    "@nexusmods/nexus-api": "github:Nexus-Mods/node-nexus-api#eeb7b953aab85bf2a336fd4999b38393a67c482a",
    "@nexusmods/vortex-api": "2.7.0-beta.1",
    "@types/bluebird": "3.5.20",
    "@types/node": "^22",
    "@types/react": "^18.3.31",
    "@types/react-bootstrap": "^0.32.20",
    "@types/react-dom": "~18.3.7",
    "@types/react-redux": "7.1.34",
    "@types/semver": "^7.7.1",
    "bluebird": "3.7.2",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "^16.2.0",
    "immutability-helper": "3.1.1",
    "madge": "8.0.0",
    "prettier": "3.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "7.2.9",
    "redux-act": "1.8.0",
    "reselect": "4.1.8",
    "rolldown": "1.0.0-rc.6",
    "semver": "7.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@bannerlord/collections": "workspace:*",
    "@bannerlord/core": "workspace:*",
    "@bannerlord/saves": "workspace:*",
    "@bannerlord/servers": "workspace:*",
    "@bannerlord/ui": "workspace:*",
    "@bannerlord/verify-files": "workspace:*",
    "@butr/vortexextensionnative": "2.0.221",
    "ticks-to-date": "^1.0.6"
  },
  "packageManager": "pnpm@12.10.1"
}
