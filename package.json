    "redux-act": "^1.7.7",
    "reselect": "^5.1.1",
    "rolldown": "1.0.0-rc.6",
    "turbowalk": "git+https://github.com/Nexus-Mods/node-turbowalk.git#cf4238a4d192763c8133500ce9b366a71b262a33",
    "typescript": "^5.4.5",
    "typescript-eslint": "8.47.0",
